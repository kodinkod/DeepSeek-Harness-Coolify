# Версия @deepseek-ai/dsh (не старше 0.2.1-rc.2). Проверить: npm view @deepseek-ai/dsh version
DSH_VERSION=0.2.1-rc.5
# Публичный адрес, по которому открываешь UI (со слешем на конце)
PUBLIC_URL=https://dsh.example.com/
# Хост из PUBLIC_URL: его Traefik передаёт в заголовке Host
TRUSTED_HOST=dsh.example.com
# Необязательно: адрес для bind, если у контейнера несколько сетей
DSH_HOST=
# Basic auth: вывод `htpasswd -nB admin` как есть, с одинарными $ (не удваивать)
DSH_BASIC_AUTH=admin:$2y$05$...
